{
  "dashboard": {
    "id": null,
    "title": "Financial Commands \u2014 SLO & Health (POS)",
    "uid": "financial-commands-pos",
    "schemaVersion": 40,
    "tags": [
      "financial",
      "slo",
      "outbox",
      "pos"
    ],
    "timezone": "browser",
    "refresh": "10s",
    "panels": [
      {
        "id": 0,
        "title": "Financial Command Error Rate",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(rate(golang_app_requests_total{service_name=~\"order-service|transaction-service\", status=\"error\"}[1m])) / sum(rate(golang_app_requests_total{service_name=~\"order-service|transaction-service\"}[1m]))",
            "refId": "A",
            "legendFormat": "error rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.0014
                },
                {
                  "color": "red",
                  "value": 0.01
                }
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        }
      },
      {
        "id": 1,
        "title": "Financial Command RPS",
        "type": "stat",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(rate(golang_app_requests_total{service_name=~\"order-service|transaction-service\"}[1m]))",
            "refId": "A",
            "legendFormat": "rps"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "rps",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "blue",
                  "value": null
                }
              ]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "textMode": "value",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        }
      },
