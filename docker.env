DB_DRIVER=postgres
DB_USERNAME=DRAGON
DB_PASSWORD=DRAGON

# Satu database = satu bounded context (prefix di pkg/database/cluster.go).
# Di dalam network compose, HOST menunjuk Service PgBouncer context-nya dan PORT
# adalah port pooler di dalam network (bukan port host 6432-6436). Key generik
# DB_HOST/DB_PORT/DB_NAME sengaja tidak ada: key per-context yang lupa diisi
# bikin service gagal start, bukan diam-diam nyambung ke instance lain.
DB_IDENTITY_HOST=pgbouncer_identity
DB_IDENTITY_PORT=5432
DB_IDENTITY_NAME=pos_identity
DB_MERCHANT_HOST=pgbouncer_merchant
DB_MERCHANT_PORT=5432
DB_MERCHANT_NAME=pos_merchant
DB_CATALOG_HOST=pgbouncer_catalog
DB_CATALOG_PORT=5432
DB_CATALOG_NAME=pos_catalog
DB_SALES_HOST=pgbouncer_sales
DB_SALES_PORT=5432
DB_SALES_NAME=pos_sales
DB_EMAIL_HOST=pgbouncer_email
DB_EMAIL_PORT=5432
DB_EMAIL_NAME=pos_email

DB_MAX_OPEN_CONNS=50
DB_MIN_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m


DB_SEEDER=true

SECRET_KEY=yantopedia

KAFKA_BROKERS=kafka:9092


# GRPC_*_ADDR: development lokal (host:port). Compose memakai
# deployments/local/docker.env (host = nama service docker).
GRPC_AUTH_ADDR=localhost:50051
GRPC_ROLE_ADDR=localhost:50052
GRPC_USER_ADDR=localhost:50053
GRPC_CATEGORY_ADDR=localhost:50054
GRPC_CASHIER_ADDR=localhost:50055
GRPC_MERCHANT_ADDR=localhost:50056
GRPC_ORDERITEM_ADDR=localhost:50057
GRPC_ORDER_ADDR=localhost:50058
GRPC_PRODUCT_ADDR=localhost:50059
GRPC_TRANSACTION_ADDR=localhost:50060


METRIC_AUTH_ADDR=8081
METRIC_ROLE_ADDR=8082
METRIC_USER_ADDR=8083
METRIC_CATEGORY_ADDR=8084
METRIC_CASHIER_ADDR=8085
METRIC_MERCHANT_ADDR=8086
METRIC_ORDERITEM_ADDR=8087
METRIC_ORDER_ADDR=8088
METRIC_PRODUCT_ADDR=8089
METRIC_TRANSACTION_ADDR=8090
